---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Menu from "../components/Menu";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
---

<!doctype html>
<html lang="en" class="w-full">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="font-assistant w-full">
    <div class="flex flex-col w-full items-center gap-16">
      <Menu
        client:visible
        currentActive={3}
        currentColorIndex={2}
        singleClickMode
      />
    </div>
    <main class="w-full flex flex-col">
      <section class="font-virgil prose prose-invert mt-24">
        <h1>hieeeeeeee! 👋</h1>

        I am <a
          class="hover:cursor-pointer font-comfortaa no-underline text-red-400 text-lg"
          href="https://www.linkedin.com/in/lucidmach/">Suraj Nukala</a
        >

        <br />

        a <strong class="text-yellow-400"> Data Visualisation </strong>
        and <strong class="text-yellow-400"> XR Enthusiast </strong>

        <img class="rounded-lg" src="/LucidMach.jpg" alt="" />
        i constantly teach myself "to build stuff that i think will blow my mind"
        and on the internet i call myself the <strong>lucidmach</strong>
        <br />
        <br />
        this time i decided to blog out my learnings as i learn and build some really
        cool stuff along the way.
        <br />
        <br />
        my core passion lies at the intersection of <strong
          >Data Visualization</strong
        > and <strong>XR (Virtual Reality / WebXR / Spatial Computing)</strong> —
        crafting high-impact immersive analytics and spatial web experiences... delivering
        interactive data stories that transform complex ideas into intuitive tools.
        <br />
        <br />
        pretty sure you know the rest 😉
      </section>
    </main>
    <Footer />
  </body>
</html>
